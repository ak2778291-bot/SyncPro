# Waitlist form endpoint. Paste a Formspree / Web3Forms / Formspark URL here
# (any service that accepts a POST of JSON form fields and returns 2xx).
# If left unset, the form falls back to opening a pre-filled mailto: to the
# address in VITE_CONTACT_EMAIL.
VITE_WAITLIST_ENDPOINT=

# Address used for the mailto: fallback and the footer contact link.
VITE_CONTACT_EMAIL=founders@syncpro.org
